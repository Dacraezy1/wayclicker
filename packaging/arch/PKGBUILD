# Maintainer: Dacraezy1 <https://github.com/Dacraezy1/wayclicker>
# Builds the command-line program from source (no GUI). For the GUI use wayclicker-bin.
pkgname=wayclicker
pkgver=0.3.0
pkgrel=1
pkgdesc="Simple autoclicker for Linux (Wayland & X11), command line"
arch=('x86_64' 'aarch64')
url="https://github.com/Dacraezy1/wayclicker"
license=('GPL-3.0-only')
depends=('glibc')
makedepends=('cargo')
optdepends=('polkit: password prompt when your user cannot access input devices')
install=wayclicker.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo build --release --locked
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    DESTDIR="$pkgdir" PREFIX=/usr ./install.sh
}
