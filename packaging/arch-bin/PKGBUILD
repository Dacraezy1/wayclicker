# Maintainer: Dacraezy1 <https://github.com/Dacraezy1/wayclicker>
# Prebuilt package with GUI. In CI the release tarball sits next to this file.
pkgname=wayclicker-bin
pkgver=0.3.0
pkgrel=1
pkgdesc="Simple autoclicker for Linux (Wayland & X11), prebuilt with GUI"
arch=('x86_64')
url="https://github.com/Dacraezy1/wayclicker"
license=('GPL-3.0-only')
depends=('glibc' 'gtk3')
optdepends=('polkit: password prompt when your user cannot access input devices')
provides=('wayclicker' 'wayclicker-gui')
conflicts=('wayclicker')
install=wayclicker.install
options=('!strip' '!debug')

if [ -f "$startdir/wayclicker-linux-x64.tar.gz" ]; then
    source=("wayclicker-linux-x64.tar.gz")
else
    source=("$url/releases/download/v$pkgver/wayclicker-linux-x64.tar.gz")
fi
sha256sums=('SKIP')

package() {
    cd "$srcdir/wayclicker-release"
    DESTDIR="$pkgdir" PREFIX=/usr ./install.sh
}
